[worldserver]

# Enable the module.
# Default: 1
BotTokenExchanger.Enable = 1

# Enable debug logging for staged-token decisions.
# Default: 0
BotTokenExchanger.Debug = 0

# Only process session-bot characters.
# Default: 1
BotTokenExchanger.OnlyPlayerbots = 1

# Write staged discovery mappings into bot_token_exchanger_token_map.
# Default: 0
BotTokenExchanger.DiscoveryWriteDb = 0

# Auto-populate staged mappings once at startup when module tables are empty.
# Default: 1
BotTokenExchanger.AutoPopulateMappings = 1

# Safety gate: when enabled, resolver/exchange commands and auto exchange only
# report what would happen and never mutate inventories.
# Default: 1
BotTokenExchanger.ResolveOnly = 1

# Allow read-only dry-run exchange resolution without mutating inventory.
# Default: 0
BotTokenExchanger.DryRun = 0

# Allow Playerbots to pass staged token rolls when the resolved reward is already owned.
# Default: 1
BotTokenExchanger.PlayerbotLootPassEnable = 1

# Allow Playerbots to pass staged token rolls when they already have a strictly
# higher item level piece equipped in the resolved reward slot.
# Default: 0
BotTokenExchanger.PlayerbotLootPassHigherItemLevelEnable = 0

# Allow real exchange execution.
# Default: 1
BotTokenExchanger.ExchangeEnable = 1

# Temporary debug-only bot targeting by exact name for console-safe tests.
# Default: 0
BotTokenExchanger.AllowDebugTargetCommand = 0

# Enable delayed automatic token exchange queueing for Playerbots.
# Default: 1
BotTokenExchanger.AutoExchangeEnable = 1

# Enable WOTLK exchange command path (single-token-chain scope only).
# Default: 0
BotTokenExchanger.WotlkExchangeEnable = 0

# Keep WOTLK exchange in dry-run mode (no inventory mutation).
# Default: 1
BotTokenExchanger.WotlkDryRun = 1

# Enable WOTLK auto exchange queue for staged single-token-chain scope only.
# Unsupported WOTLK structures (emblem_like, upgrade-chain) remain excluded.
# Default: 0
BotTokenExchanger.WotlkAutoExchangeEnable = 0

# Emit throttled unresolved WOTLK single-token-chain telemetry logs.
# Prefix: WOTLK_UNRESOLVED:
# Logs once per token/family/class/spec/role/outcome key per cooldown window.
# Default: 1
BotTokenExchanger.WotlkTelemetryEnable = 1

# Run headless validation once at startup for servers without interactive console/RA.
# Default: 0
BotTokenExchanger.RunValidationOnStartup = 0

# Startup validation mode:
#   none        -> disable startup validation
#   tbc         -> status + validate tbc + validate tbc unresolved
#   wotlk_single-> status + validate wotlk single
#   both        -> status + tbc + wotlk_single
# Default: "none"
BotTokenExchanger.StartupValidationMode = "none"

# Delay before startup validation executes (milliseconds).
# Useful on headless servers where Playerbots load after world startup.
# Default: 60000
BotTokenExchanger.StartupValidationDelayMs = 60000

# Delay before queued auto exchange is processed.
# Default: 1500
BotTokenExchanger.AutoExchangeDelayMs = 1500

# Delay before retrying a queued token after a retryable failure such as a full bag.
# Default: 30000
BotTokenExchanger.AutoExchangeRetryDelayMs = 30000

# Queue auto exchange when a staged token is stored on loot/item receipt.
# Default: 1
BotTokenExchanger.AutoExchangeOnLoot = 1

# Queue auto exchange when a Playerbot logs in.
# Default: 0
BotTokenExchanger.AutoExchangeOnLogin = 0

# Maximum exchanges per bot per processing pass.
# Default: 1
BotTokenExchanger.AutoExchangeMaxPerBotPerPass = 1

# Placeholder for optional owner announcements in later phases.
# Default: 0
BotTokenExchanger.AnnounceToBotOwner = 0

# Reserved for exchange queue processing.
# Default: 1000
BotTokenExchanger.ExchangeDelayMs = 1000
